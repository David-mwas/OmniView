{
  "manifest_version": 3,
  "name": "OmniView — Universal Device Simulator",
  "version": "1.2.0",
  "description": "Free, open-source responsive device simulator with 55+ devices, Live Sync, Vision & X-Ray QA, Mockup Studio Annotations, MP4 Trim & Live Device QR.",
  "minimum_chrome_version": "116",
  "permissions": [
    "declarativeNetRequest",
    "tabs",
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["syncBridge.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open in OmniView Simulator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
